# ===== إعدادات Nonzra =====
# الوضع الافتراضي: مجاني بالكامل، بلا حدود، بلا مفتاح إلزامي.
NONECAP_UNLIMITED=1

# للتضييق عند النشر العام (اختياري):
# NONECAP_UNLIMITED=0
# NONECAP_RATE_LIMIT_PER_MINUTE=120
# NONECAP_KEY_RATE_LIMIT_PER_MINUTE=60
# NONECAP_IP_BLOCK_SECONDS=300
# NONECAP_REQUIRE_API_KEY=1

# سعة المعالجة
NONECAP_CONCURRENCY=4
NONECAP_MAX_CONCURRENCY=16
NONECAP_MAX_BATCH=200
NONECAP_JOB_TTL_SECONDS=3600
NONECAP_MAX_JOBS=5000

# التخزين والأمان
DATABASE_URL=sqlite:////app/data/nonecap_clone.db
# مفتاح ثابت لتشفير مفاتيح API (ولّده مرة واحدة واحفظه)
# NONECAP_ENCRYPTION_KEY=change-me-to-a-long-random-string

# CORS للوحات الخارجية (فارغ = مغلق)
# NONECAP_CORS_ORIGINS=*
